@inherits LayoutComponentBase
@inject NavigationManager Navigation

<MudLayout>
    @if (!Navigation.Uri.EndsWith("/", StringComparison.OrdinalIgnoreCase) && 
         !Navigation.Uri.EndsWith("/login", StringComparison.OrdinalIgnoreCase) && 
         !Navigation.Uri.EndsWith("/register", StringComparison.OrdinalIgnoreCase))
    {
        <NavMenu />
    }

    <MudMainContent>
        <MudContainer>
            @* <MudPaper> *@
                @Body
            @* </MudPaper> *@
        </MudContainer>
    </MudMainContent>
</MudLayout>
