@inherits LayoutComponentBase
@inject NavigationManager Navigation

@if (Navigation.Uri.EndsWith("/", StringComparison.OrdinalIgnoreCase) || 
     Navigation.Uri.Contains("login", StringComparison.OrdinalIgnoreCase) || 
     Navigation.Uri.Contains("register", StringComparison.OrdinalIgnoreCase))
{
   <MudLayout>
    <MudMainContent>
        <MudContainer >
            <MudPaper>
            @Body  
            </MudPaper>
        </MudContainer>
    </MudMainContent>
</MudLayout>  
}
else
{
    <MudLayout>
        <NavMenu />

        <MudMainContent>
            <MudContainer >
                @Body  
            </MudContainer>
        </MudMainContent>
    </MudLayout>
}
