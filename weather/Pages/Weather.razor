@page "/weather"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@using MudBlazor
@inject HttpClient Http
@inject GlobalState GlobalState
@inject ISnackbar Snackbar
@inject HttpClient Http
@inject AppSettingsService Settings


<MudContainer MaxWidth="MaxWidth.Medium" Color="Color.Primary" Class="weather-container pt-20">
    <MudPaper Elevation="4" Class="pa-10 ma-2" Style="@($"background-color:{Colors.Indigo.Lighten5};")"
        Color="Color.Primary">
        <MudText Typo="Typo.h4" Align="Align.Center">Weather Forecast</MudText>

        <MudTextField Label="Enter City" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="City" />

        <MudStack Direction="Direction.Row" Spacing="2" Class="mt-4">
    <MudButton Color="Color.Primary"OnClick="() => GetWeather(City)" Disabled="isLoading">
        @if (isLoading)
        {
            <MudProgressCircular Size="Size.Large" Color="Color.Info" Indeterminate="true" />
        }
        else
        {
            <MudText Typo="Typo.button" Class="ml-2">Get Weather Report</MudText>
        }
    </MudButton>

    <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@OpenDialog" Size="Size.Small">
        Add Favorite City
    </MudButton>

    <MudButton Color="Color.Secondary" Variant="Variant.Filled" OnClick="Get7DayForecast" Disabled="isLoading || string.IsNullOrEmpty(City)">
        View 7 Days Forecast
    </MudButton>
</MudStack>

<MudPopover Open="@_open" AnchorOrigin="Origin.CenterCenter" TransformOrigin="Origin.CenterCenter">
            <div class="pa-10">
                <MudSelect class="pb-4" MultiSelection="true" @bind-Value="_value" @bind-SelectedValues="_options"
                    Variant="Variant.Outlined">
                    @foreach (var state in _states)
                    {
                        <MudSelectItem T="string" Value="@state">@state</MudSelectItem>
                    }
                </MudSelect>

                <MudStack Spacing="2">
                    <MudButton Variant="Variant.Outlined" Color="Color.Success" OnClick="@AddFavoriteCity">Submit
                    </MudButton>

                    <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="@OpenDialog">Close
                    </MudButton>
                </MudStack>

            </div>
        </MudPopover>
        @if (weatherData != null)
        {
            <MudCard Class="mt-4">
                <MudCardContent>
                    <MudText Typo="Typo.h4" Align="Align.Center">@weatherData.Name</MudText>
                    <MudCard class="pa-2 cursor-pointer" Style="@($"background-color:{Colors.Indigo.Lighten5};")"
                        Width="300px">
                        <MudText Typo="Typo.h5">@weatherData.Weather[0].Description.ToUpper()</MudText>
                    </MudCard>
                    <MudText Typo="Typo.h6">Temperature: @weatherData.Main.Temp °C</MudText>
                    <MudText Typo="Typo.h6">Humidity: @weatherData.Main.Humidity%</MudText>
                    <MudText Typo="Typo.h6">Wind Speed: @weatherData.Wind.Speed m/s</MudText>
                </MudCardContent>
            </MudCard>
        }
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mt-4" Visible="@(errorMessage != null)">
                No Favourites...
            </MudAlert>
        }

    </MudPaper>
</MudContainer>


@if (showForecast && forecastData.Count > 0)
{
    <MudTable Items="forecastData" Hover="true" Dense="true" Striped="true" Elevation="1" Class="mt-4">
        <HeaderContent>
            <MudTh>Date</MudTh>
            <MudTh>Weather</MudTh>
            <MudTh>Temp (°C)</MudTh>
            <MudTh>Min</MudTh>
            <MudTh>Max</MudTh>
            <MudTh>Humidity (%)</MudTh>
            <MudTh>Wind Speed (km/h)</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Date">@context.ParsedDate.ToString("ddd, MMM dd")</MudTd>
            <MudTd DataLabel="Weather">@context.day.condition.text</MudTd>
            <MudTd DataLabel="Temp">@context.day.avgtemp_c</MudTd>
            <MudTd DataLabel="Min">@context.day.mintemp_c</MudTd>
            <MudTd DataLabel="Max">@context.day.maxtemp_c</MudTd>
            <MudTd DataLabel="Humidity">@context.day.avghumidity</MudTd>
            <MudTd DataLabel="Wind Speed">@context.day.maxwind_kph</MudTd>
        </RowTemplate>
    </MudTable>
}


<MudContainer MaxWidth="MaxWidth.Medium" Color="Color.Primary" Class="weather-container pt-20">
    <MudPaper Elevation="4" Class="pa-10 ma-2" Style="@($"background-color:{Colors.Indigo.Lighten5};")"
        Color="Color.Primary">
        <MudText Typo="Typo.h5" Align="Align.Center">Favourites Cities for @GlobalState.UserName...</MudText>

        <MudList T="string">
            @if (favoriteCities.Count > 0)
            {
                @foreach (var city in favoriteCities)
                {
                    <MudChip T="string" Color="Color.Primary" Variant="Variant.Text" OnClick="() => GetWeather(city)">@city
                    </MudChip>
                }
            }
            else
            {
                <MudListItem>
                    <MudText Typo="Typo.body1" Color="Color.Primary">No favorite cities added.</MudText>
                </MudListItem>
            }
        </MudList>
    </MudPaper>
</MudContainer>




@code {
    private string City { get; set; } = "London";
    private bool isLoading = false;
    private string? errorMessage = null;
    private WeatherResponse? weatherData;
    private bool showForecast = false;
    private List<ForecastDay> forecastData = new();
    private List<string> favoriteCities = new();


    public bool _open;
    public void OpenDialog()
    {
        if (_open)
        {
            _open = false;
        }
        else
        {
            _open = true;
        }
    }
    private string _value = "Nothing selected";
    private IEnumerable<string> _options = new HashSet<string> { "Tirupur" };
    private readonly string[] _states =
    [
    "Chennai", "Coimbatore", "Madurai", "Tiruchirappalli", "Salem",
"Erode", "Tirunelveli", "Vellore", "Thoothukudi", "Dindigul",
"Thanjavur", "Ranipet", "Sivakasi", "Kanchipuram", "Nagercoil",
"Kumbakonam", "Karur", "Udhagamandalam (Ooty)", "Cuddalore",
"Hosur", "Ambur", "Pudukkottai", "Nagapattinam", "Tiruvannamalai",
"Ariyalur", "Pollachi", "Karaikudi", "Namakkal", "Dharmapuri",
"Tenkasi", "Perambalur", "Theni", "Mayiladuthurai", "Villupuram",
"Krishnagiri", "Tirupattur","Tirupur"
    ];


    private async Task GetWeather(string? selectedCity = null)
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            string cityToFetch = selectedCity ?? City;
            string apiKey = "89356047c4e56dd8d6f6ed9836260769";
            string url = $"https://api.openweathermap.org/data/2.5/weather?q={cityToFetch}&appid={apiKey}&units=metric";

            weatherData = await Http.GetFromJsonAsync<WeatherResponse>(url);
        }
        catch (Exception)
        {
            errorMessage = "Failed to fetch weather data.";
        }

        isLoading = false;
    }

    public class WeatherResponse
    {
        public string Name { get; set; } = "";
        public MainData Main { get; set; } = new();
        public WindData Wind { get; set; } = new();
        public List<WeatherDescription> Weather { get; set; } = new();
    }

    private async Task AddFavoriteCity()
    {
        try
        {
            var userid = @GlobalState.UserId;
            var body = new
            {
                userId = userid,
                cities = _options
            };

            var response = await Http.PostAsJsonAsync($"{Settings.ApiBaseUrl}/api/fav", body);
            if (response.IsSuccessStatusCode)
            {
                @* errorMessage = "Favorite city added successfully."; *@
                await FetchFavoriteCities();
                Snackbar.Add($"Success {"Favorite city added successfully"}", Severity.Success);

            }
            else
            {
                @* errorMessage = "Failed to add favorite city."; *@
                await FetchFavoriteCities();
                Snackbar.Add($"Error {"Failed to add favorite city."}", Severity.Error);
            }
        }
        catch (Exception)
        {
            errorMessage = "Failed to add favorite city.";
        }
    }

public class ForecastDay
    {
        public string date { get; set; } = "";
        public Day day { get; set; } = new();
        public DateTime ParsedDate => DateTime.Parse(date);
    }

    public class Day
    {
        public double maxtemp_c { get; set; }
        public double mintemp_c { get; set; }
        public double avgtemp_c { get; set; }
        public double avghumidity { get; set; }
        public double maxwind_kph { get; set; }
        public Condition condition { get; set; } = new();
    }

    public class Condition
    {
        public string text { get; set; } = "";
    }

    public class ForecastResponse
    {
        public Forecast forecast { get; set; } = new();
    }

    public class Forecast
    {
        public List<ForecastDay> forecastday { get; set; } = new();
    }

    private async Task Get7DayForecast()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            showForecast = false;

            if (string.IsNullOrWhiteSpace(City))
            {
                errorMessage = "Please enter a city name.";
                return;
            }

            string apiKey = "a239da81dc2a4cceb05154414251304"; 
            string url = $"https://api.weatherapi.com/v1/forecast.json?key={apiKey}&q={City}&days=7&aqi=no&alerts=no";

            var response = await Http.GetFromJsonAsync<ForecastResponse>(url);

            if (response != null && response.forecast.forecastday != null)
            {
                forecastData = response.forecast.forecastday;
                showForecast = true;
            }
            else
            {
                errorMessage = "No forecast data found.";
            }
        }
        catch (Exception)
        {
            errorMessage = "Error fetching forecast data.";
        }
        finally
        {
            isLoading = false;
        }
    }


    private async Task FetchFavoriteCities()
    {
        try
        {
            var userid = GlobalState.UserId;
            Console.WriteLine($"UserID: {userid}");
            var body = new { UserId = userid };
            var response = await Http.PostAsJsonAsync($"{Settings.ApiBaseUrl}/api/fav/get-favorites", body);

            if (response.IsSuccessStatusCode)
            {
                var cities = await response.Content.ReadFromJsonAsync<List<string>>();
                if (cities != null)
                {
                    favoriteCities = cities;
                }
            }
            else
            {
                errorMessage = "Failed to fetch favorite cities.";
            }
        }
        catch (Exception)
        {
            errorMessage = "Failed to fetch favorite cities.";
        }
    }


    protected override async Task OnInitializedAsync()
    {
        await GlobalState.LoadUserData();
        await FetchFavoriteCities();
    }

    public class MainData { public double Temp { get; set; } public int Humidity { get; set; } }
    public class WindData { public double Speed { get; set; } }
    public class WeatherDescription { public string Description { get; set; } = ""; }


}
